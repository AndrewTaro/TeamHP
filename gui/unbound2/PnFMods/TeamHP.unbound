# Install gating comes from modPrefs.installedMods (Python-scanned), so a consumer no longer advertises
# itself with a TT_<MOD>_INSTALLED constant.  There is no element-name constant either: that string was
# the legacy chatBoxWidth position prefix, and Python owns positions + resKey now.
(def constant THP_COMPONENT_KEY 'modTeamHP')
(def constant THP_TEXT_WIDTH 55px)
(def constant THP_BLOCK_WIDTH 10px)

(def constant THP_BLOCK_SIZE {
	WIDTH   : 10px,
	HEIGHT  : 20px,
})

# The off/on/alt-vision triple is shared as TT_CONST.DISPLAY_MODE {DISABLED,ENABLED,ADAPTIVE}
# (TTaroModConfigSharedConstants.unbound) -- never re-declare a per-mod copy of it.
(def constant THP_STYLES {
	HP_AND_BAR   : 0,
	BAR_AND_HP   : 1,
})

(def constant THP_BAR_DIRECTIONS {
	LEFT   : 0,
	RIGHT  : 1,
})

(def constant THP_HEALTH_TYPES {
	RELATIVE: 0,
	ABSOLUTE: 1,
})

(def element THP_TeamHP () layout=true
    (scope
        (var entityWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, THP_COMPONENT_KEY)")
		(var armamentEntity:gfx = "entityWatcher.entity" (event "entityWatcher.event"))
		(var dataComponent:gfx = "armamentEntity ? armamentEntity.mods_DataComponent : null")
		(var healthData:dict = "dataComponent ? dataComponent.data : {}" (event "dataComponent.evDataChanged"))
    )

    # Ally
    (element THP_TeamHealthItem _healthData="healthData" _isAlly=true)

    # Enemy
    (element THP_TeamHealthItem _healthData="healthData" _isAlly=false)
)

(def element THP_TeamHealthItem(_healthData:dict, _isAlly:bool=true)
    (scope
        (event evAddedToStage)

        (var teamKey:str = "_isAlly ? 'ally' : 'enemy'")
        (var teamData:dict = "teamKey in _healthData ? _healthData[teamKey] : {}")
        (var maxHP:number = "'maxHP' in teamData ? teamData.maxHP : 0")
        (var currentHP:number = "'currentHP' in teamData ? teamData.currentHP : 0")
        (var maxRegen:number = "'maxRegen' in teamData ? teamData.maxRegen : 0")

        (macro TT_GET_PREF _varName="'lockPref'" _key="'teamHP.disableDragdrop'")
        (var isPositionLocked:bool = "null != lockPref && null != lockPref.value ? lockPref.value : false")

        # Per-team key PREFIX, built at runtime -- ally and enemy are two independent subtrees of the
        # schema, so the dotted key is composed at each call site (`revPref + '.styleIndex'`);
        # TT_GET_PREF's _key takes the built expression.  The draggables hang off the same prefix as
        # `<prefix>.position` -- a position key is never the prefix itself, or its opaque bucket map
        # would share a node with the siblings here and eat them (see the framework's BUILD_STATE #2).
        (var revPref:str = "_isAlly ? 'teamHP.ally' : 'teamHP.enemy'")

        # Ally and enemy carry DIFFERENT schema defaults for both dropdowns, so the pre-publish
        # fallback is per-team too.
        (macro TT_GET_PREF _varName="'stylePref'" _key="revPref + '.styleIndex'")
        (var styleIndex:number = "null != stylePref && null != stylePref.value ? stylePref.value : _isAlly ? THP_STYLES.HP_AND_BAR : THP_STYLES.BAR_AND_HP")
        (var isReversed:bool = "styleIndex == THP_STYLES.HP_AND_BAR")
        (var flowDir:number = "isReversed ? Flow.REVERSE_HORIZONTAL : Flow.HORIZONTAL")

        (macro TT_GET_PREF _varName="'barDirPref'" _key="revPref + '.barDirection'")
        (var barDirection:number = "null != barDirPref && null != barDirPref.value ? barDirPref.value : _isAlly ? THP_BAR_DIRECTIONS.LEFT : THP_BAR_DIRECTIONS.RIGHT")
        (var isBarReversed:bool = "barDirection == THP_BAR_DIRECTIONS.LEFT")

        (var cameraComponent:gfx = "$datahub.getSingleComponent(CC.camera)")
	    (var altVision:bool = "cameraComponent ? cameraComponent.altVision : false" (event "cameraComponent.evAltVisionChanged"))

        # BG
        (macro TT_GET_PREF _varName="'bgAlphaPref'" _key="'teamHP.background.alpha'")
        (var bgAlpha:number = "null != bgAlphaPref && null != bgAlphaPref.value ? bgAlphaPref.value : 0.4")
        (macro TT_GET_PREF _varName="'bgModePref'" _key="'teamHP.background.displayMode'")
        (var bgDisplayMode:number = "null != bgModePref && null != bgModePref.value ? bgModePref.value : TT_CONST.DISPLAY_MODE.DISABLED")
        (var isBGVisible:bool = "bgDisplayMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision : bgDisplayMode")

        # Main
        (macro TT_GET_PREF _varName="'displayModePref'" _key="'teamHP.displayMode'")
        (var displayMode:number = "null != displayModePref && null != displayModePref.value ? displayModePref.value : TT_CONST.DISPLAY_MODE.ENABLED")
        (var isVisible:bool = "maxHP ? displayMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision
                                                                                    : displayMode
                                     : false
        ")

        # Python owns the position value, the resKey bucket AND the first-placement default
        # (CMS-authored anchor/offset), so there is no view-side default or stage math here.
        (macro TT_DRAGGABLE_POSITION _fullKey="revPref + '.position'")
    )

    (style
        (position = "absolute")
        (bind left "dragX")
        (bind top "dragY")
        (bind pivotX "isBarReversed ? 100% : 0%")
        (alpha = 0)
    )

    (bind visible "isVisible")

    (dispatch evAddedToStage args="{}" on=addedToStage)
    (controller $Animation
        (bindcall play 
            from     = "{visualOffsetY: -10, alpha: 0}"
            to       = "{visualOffsetY:   0, alpha: 1}"
            delay    = "3"
            duration = "0.3"
            (event "evAddedToStage")
        )
    )

    # Full-size transparent drag surface.  MUST stay declared BEFORE the BG/content blocks below --
    # that document order is what keeps TT_DRAGGABLE's signifier behind them (zindex does not cross a
    # block boundary).  hitTest follows the lock: the macro gates the drag writes and the signifier,
    # but only dropping hitTest here also suppresses the drag-hint tooltip.
    (block
        (class $FullsizeAbsolute)
        (style (backgroundColor = 0x00FFFFFF))
        (bind hitTest "!isPositionLocked")
        (macro TT_DRAGGABLE _fullKey="revPref + '.position'" _isDragEnabled="!isPositionLocked")
    )

    # BG
    (block
        (bind visible "isBGVisible")
        (style
            (hitTest = false)
            (bind alpha "bgAlpha")
        )
        (class $FullsizeAbsolute)
        (mc contrast_panel
            (class $FullsizeAbsolute)
        )
        (mc hint_panel
            (class $FullsizeAbsolute)
        )
    )

    # Main
    (block
        (style
            (align = "middle|center")
            (hitTest = false)
            (hgap = 5px)
            (bind flow "flowDir")
            (padding = 2)
        )
        
        # Bar
        (element THP_TeamHealthBar
            _currentHP  = "currentHP"
            _maxHP      = "maxHP"
            _maxRegen   = "maxRegen"
            _isAlly     = "_isAlly"
        )
        # Text
        (element THP_TeamHealthText
            _currentHP    = "currentHP"
        )
    )
)

(def element THP_TeamHealthBar(_currentHP:number, _maxHP:number, _maxRegen:number, _isAlly:bool=true)
    (scope
        (var revPref:str = "_isAlly ? 'teamHP.ally' : 'teamHP.enemy'")
        (macro TT_GET_PREF _varName="'barDirPref'" _key="revPref + '.barDirection'")
        (var barDirection:number = "null != barDirPref && null != barDirPref.value ? barDirPref.value : _isAlly ? THP_BAR_DIRECTIONS.LEFT : THP_BAR_DIRECTIONS.RIGHT")

        (macro TT_GET_PREF _varName="'blockHeightPref'" _key="'teamHP.style.blockHeight'")
        (var heightMultiplier:number = "null != blockHeightPref && null != blockHeightPref.value ? blockHeightPref.value : 1")
        (macro TT_GET_PREF _varName="'blockWidthPref'" _key="'teamHP.style.blockWidth'")
        (var widthMultiplier:number = "null != blockWidthPref && null != blockWidthPref.value ? blockWidthPref.value : 1")
        (macro TT_GET_PREF _varName="'blockMarginPref'" _key="'teamHP.style.blockMargin'")
        (var blockMargin:number = "null != blockMarginPref && null != blockMarginPref.value ? blockMarginPref.value : 1")

        # blockCount drives RELATIVE mode, healthPerBlock ABSOLUTE -- healthType picks which; the other
        # setting is greyed in the config panel but still reads its stored value here.
        (macro TT_GET_PREF _varName="'blockCountPref'" _key="'teamHP.style.blockCount'")
        (var blockCount:number = "null != blockCountPref && null != blockCountPref.value ? blockCountPref.value : 20")
        (macro TT_GET_PREF _varName="'blockHealthPref'" _key="'teamHP.style.blockHealth'")
        (var healthPerBlock:number = "null != blockHealthPref && null != blockHealthPref.value ? blockHealthPref.value : 30000")
        (macro TT_GET_PREF _varName="'healthTypePref'" _key="'teamHP.healthType'")
        (var healthType:number = "null != healthTypePref && null != healthTypePref.value ? healthTypePref.value : THP_HEALTH_TYPES.RELATIVE")

        (var isRelativeMode:bool = "healthType == THP_HEALTH_TYPES.RELATIVE")
        
        # Use ceil so that tiney HP like 100 can still be displayed as non-zero value
        (var divisor:number = "isRelativeMode ? _maxHP  ? ceil(_maxHP / blockCount)
                                                        : -1
                                              : healthPerBlock")
        (var currentBlocks:number = "ceil(_currentHP / divisor)")
        (var maxBlocks:number = "isRelativeMode ? blockCount : ceil(_maxHP / divisor)")
        (var regenBlocks:number = "ceil(_maxRegen / divisor)")
        (var blockWidth:number = "round(THP_BLOCK_SIZE.WIDTH * widthMultiplier)")
        (var blockHeight:number = "round(THP_BLOCK_SIZE.HEIGHT * heightMultiplier)")

        (var isBarReversed:bool = "barDirection == THP_BAR_DIRECTIONS.LEFT")
        (var flowDir:number = "isBarReversed ? Flow.REVERSE_HORIZONTAL : Flow.HORIZONTAL")
    )

    (hblock
        (style
            (bind flow "flowDir")
        )
        (controller $Repeat renderer='THP_HealthBlock'
            (bind enabled "maxBlocks > 0")
            (bind count "maxBlocks")
            (args
                _blockWidth     = "blockWidth"
                _blockHeight    = "blockHeight"
                _blockMargin    = "blockMargin"
                _currentBlocks  = "currentBlocks"
                _regenBlocks    = "regenBlocks"
                _isAlly         = "_isAlly"
            )
        )
    )
)

(def element THP_HealthBlock(_blockWidth:number, _blockHeight:number, _blockMargin:number, _currentBlocks:number, _regenBlocks:number, _isAlly:bool=true)
    (scope
        (var blockIndex:number = "$index + 1")
        (var isRegen:bool = "blockIndex <= _regenBlocks")
        (var isHealth:bool = "blockIndex <= _currentBlocks")
        (var teamColor:number = "_isAlly ? C_ALLY : C_ENEMY")
        (var ctKey:str = "_isAlly ? 'ally' : 'enemy'")
        (var color:number = "isHealth   ? teamColor :
                             isRegen    ? 0xff999999
                                        : C_DARK_T "
        )
    )
    (style
        (bind height "_blockHeight")
        (bind width "_blockWidth")
        (bind backgroundColor "color")
        (bind marginLeft "_blockMargin")
        (bind marginRight "_blockMargin")
        (pivotX = 50%)
        (pivotY = 50%)
    )

    # Outline for Regen
    (block
        (class $FullsizeAbsolute)
        (style (backgroundImage = 'url:../service_kit/frames/one_pixel_frame.png') (scale9grid = 2) (alpha = 1))
        (bind colorTransform "TWO_TEAMS_COLOR_TRANSFORMS[ctKey]")
        (bind visible "isRegen || isHealth")
    )

    # For animation
    (block
        (class $Fullsize)
        (style
            (bind backgroundColor "isHealth ? teamColor : 0xffffffff")
            (pivotX = 50%)
            (pivotY = 50%)
            (alpha = 0)
        )
        (controller $Animation
            # Health Reduction
            (bindcall play
                duration= 1
                from    = {visualScaleX: 1.0, visualScaleY: 1.0, alpha:1}
                to      = {visualScaleX: 2.0, visualScaleY: 3.0, alpha:0}
                action  = "killAll" 
                easing  = "Easing.quad_out"
                (bind enabled "!isHealth")
                (bind trigger "isHealth")
            )
            # Health Addition
            (bindcall play
                duration= 1
                from    = {visualScaleX: 2.0, visualScaleY: 3.0, alpha:0.6}
                to      = {visualScaleX: 1.0, visualScaleY: 1.0, alpha:0.0}
                action  = "killAll"
                # easing  = "Easing.cubic_in"
                (bind enabled "isHealth")
                (bind trigger "isHealth")
            )
        )
    )
)

(def element THP_TeamHealthText(_currentHP:number)
    (scope
        (var hpKilo:number = "_currentHP / 1000") # Use ceil so that tiney HP like 100 can still be displayed as non-zero value
        (var hpText:str = "hpKilo < 100 ? formatFloatingPoint(hpKilo) : ceil(hpKilo)")
        (var displayHP:str = "hpText + 'K' ")

        (macro TT_GET_PREF _varName="'fontSizePref'" _key="'teamHP.style.fontSize'")
        (var fontSize:number = "null != fontSizePref && null != fontSizePref.value ? fontSizePref.value : 18")
    )
    (style
        (width = "THP_TEXT_WIDTH")
        (align = "middle|center")
    )
    (tf
        (class $TextDefaultBold)
        (class $FontEnableReadability)
        (style
            (width = 100%)
            (textAlign = "center")
            (bind fontSize "fontSize")
            (marginTextTop = -6px)
	        (marginTextBottom = -5px)
        )
        (bind text "displayHP")
    )
)